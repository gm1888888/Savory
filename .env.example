# ---------------------------------------------------------------------------
# Supabase -- copy this file to .env.local and fill in your own values.
#
# Find both values in your Supabase dashboard under:
#   Project Settings -> API
#
# Both are PUBLIC values. They are safe in the browser because every table is
# protected by Row Level Security. Never add the service_role key here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED in production. Used to build absolute links in confirmation emails.
# Local development: http://localhost:3000
# Production:        https://your-project.vercel.app
#
# If this is left unset in production, the app falls back to localhost rather
# than trusting request headers for a security-sensitive URL (see
# src/app/actions/auth.ts). Always set this on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. How long a login lasts before the visitor must log in again.
# Defaults to 7 days (604800 seconds). Only set this to change that limit.
# SESSION_MAX_AGE_SECONDS=604800
